# AI Adoption Studio — Environment Configuration
# Copied to .env on first `studio up` (generate-once, reuse-every-time).
# Internal tool: these are static config values, not managed secrets.

# Artifact storage root
STUDIO_DATA_ROOT=./data

# Operator wizard/API auth — fixed dev constant (not a secret; must match server)
STUDIO_INTERNAL_API_KEY=dev-key

# Public EOI rate limit
STUDIO_EOI_RATE_LIMIT_PER_MINUTE=30

# Gateway bearer token — the ONE technically-required credential.
# Set this to the SAME stable value as ai-gateway BOOTSTRAP_ADMIN_KEY and
# deployment-catalog GATEWAY_API_KEY so it survives restarts (see Gateway ADR-006).
STUDIO_PLATFORM_API_KEY=sk-local-dev-change-me

# Dependency base URLs (local dev defaults)
STUDIO_GATEWAY_BASE_URL=http://localhost:8000
STUDIO_RUNTIME_MANAGER_BASE_URL=http://localhost:8001
STUDIO_CONTROL_CENTRE_BASE_URL=http://localhost:8002

# Sibling repo roots (relative to ai-adoption-studio)
STUDIO_DELIVERY_VALIDATOR_ROOT=../ai-delivery-validator
STUDIO_DEPLOYMENT_CATALOG_ROOT=../deployment-catalog

# Studio server port
STUDIO_PORT=8010

# Cursor agent assist (optional — Phase 4)
STUDIO_CURSOR_API_KEY=
STUDIO_CURSOR_WORKSPACE_ROOT=..
STUDIO_CURSOR_MODEL=composer-2.5

# Internal narrative generation (optional)
LOCAL_LLM_BASE_URL=
